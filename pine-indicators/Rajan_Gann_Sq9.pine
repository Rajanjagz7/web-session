// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © Rajan — Rajan Gann Square of 9
// Gann Square of 9 intraday levels from day open / prev close: BUY above U1, SELL below D1, targets at the next Gann levels, SL at base, level-by-level trailing SL, Gann HiLo trend filter.
//@version=6
indicator("Rajan Gann Square of 9", shorttitle="RAJAN Gann Sq9", overlay=true, max_labels_count=500, max_lines_count=100)

// ═════════════════ Risk & position size ═════════════════
grpR       = "① Risk & position size"
instMode   = input.string("Index → ATM options", "Trade instrument", options=["Index → ATM options", "Direct (stock / future / option chart)"], group=grpR, tooltip="Index → ATM options: a BUY on NIFTY means buy the ATM Call, a SELL means buy the ATM Put. Direct: trade the charted symbol itself.")
strikeStep = input.float(50, "Strike step", minval=1, group=grpR, tooltip="NIFTY 50 · BANKNIFTY 100 · FINNIFTY 50 · SENSEX 100")
optDelta   = input.float(0.5, "Option delta (premium SL estimate)", minval=0.1, maxval=1.0, step=0.05, group=grpR, tooltip="ATM options move ≈0.5 × the index. Used only to estimate the premium stop and lot size.")
capital    = input.float(100000, "Capital (₹)", minval=1, group=grpR)
riskPct    = input.float(1.0, "Risk per trade (%)", minval=0.1, maxval=10, step=0.1, group=grpR)
lotSize    = input.int(75, "Lot size", minval=1, group=grpR)
isOptMode  = instMode == "Index → ATM options"

grpT = "② Targets & trailing stop"
beAfterT1    = input.bool(true, "Move SL to entry (breakeven) after T1", group=grpT)
lockAfterT2  = input.bool(true, "Move SL to T1 after T2", group=grpT)
trailStart   = input.string("After T1", "Trailing SL starts", options=["Immediately", "After T1", "Off"], group=grpT)
exitAtT3     = input.bool(false, "Exit fully at T3", group=grpT)
allowReverse = input.bool(true, "Reverse on opposite signal", group=grpT)

// ═════════════════ Intraday session ═════════════════
grpX     = "③ Intraday session (IST)"
useSess  = input.bool(true, "Take entries only inside window", group=grpX)
sess     = input.session("0920-1500", "Entry window", group=grpX)
useSqOff = input.bool(true, "Square off open trade at", inline="sq", group=grpX)
sqH      = input.int(15, "", minval=9, maxval=15, inline="sq", group=grpX)
sqM      = input.int(20, ":", minval=0, maxval=59, inline="sq", group=grpX)

// ═════════════════ Display ═════════════════
grpD       = "④ Display"
showDash   = input.bool(true, "Show trade dashboard", group=grpD)
dashLoc    = input.string("Top Right", "Dashboard position", options=["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group=grpD)
dashSizeIn = input.string("Small", "Dashboard text size", options=["Tiny", "Small", "Normal"], group=grpD)
showLevels = input.bool(true, "Show entry / SL / target lines", group=grpD)
showLabels = input.bool(true, "Show signal & event labels", group=grpD)

tz       = "Asia/Kolkata"
isIntra  = timeframe.isintraday
inSess   = not useSess or not isIntra or not na(time(timeframe.period, sess, tz))
barMin   = hour(time_close, tz) * 60 + minute(time_close, tz)
sqOffNow = useSqOff and isIntra and barMin >= sqH * 60 + sqM

fmt(float x) => na(x) ? "—" : str.tostring(x, format.mintick)

// Colours (one palette for every Rajan indicator)
cBull  = #26a69a
cBear  = #ef5350
cGold  = #f5b942
cMuted = #8b98a9
cText  = #e6edf3
cPanel = #10161d
cEdge  = #2a3441

// ═════════════════ Signal: Gann Square of 9 levels + Gann HiLo trend ═════════════════
grpS     = "⑤ Gann Square of 9"
baseMode = input.string("Day open", "Base price", options=["Day open", "Previous close"], group=grpS, tooltip="Square of 9 levels are built from this price every day.")
angle    = input.string("45°", "Level step (angle)", options=["22.5°", "45°", "90°"], group=grpS, tooltip="Each level = (√base ± n × step)². 360° on the square = +2 on the root, so 45° = 0.25, 22.5° = 0.125, 90° = 0.5. Smaller angle = closer levels.")
useHiLo  = input.bool(true, "Trend filter: Gann HiLo activator", group=grpS)
hiloLen  = input.int(3, "HiLo length", minval=1, group=grpS)
slMode   = input.string("Base level", "Initial stop", options=["Base level", "Halfway to base"], group=grpS, tooltip="BUY above level 1: stop at the base, or halfway between the base and level 1 (tighter).")
oncePerDay = input.bool(true, "One trade per side per day", group=grpS)

step   = angle == "22.5°" ? 0.125 : angle == "45°" ? 0.25 : 0.5
newDay = timeframe.change("D")
prevC  = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_on)
var float dOpen = na
var bool  tookL = false
var bool  tookS = false
if newDay
    dOpen := open
    tookL := false
    tookS := false
base = baseMode == "Day open" ? dOpen : prevC
rt   = math.sqrt(base)

gLvl(float r, float st, int n) => math.pow(r + n * st, 2)
U1 = gLvl(rt, step, 1)
U2 = gLvl(rt, step, 2)
U3 = gLvl(rt, step, 3)
U4 = gLvl(rt, step, 4)
D1 = gLvl(rt, step, -1)
D2 = gLvl(rt, step, -2)
D3 = gLvl(rt, step, -3)
D4 = gLvl(rt, step, -4)

hima = ta.sma(high, hiloLen)
loma = ta.sma(low, hiloLen)
var int hilo = 0
hilo := close > hima[1] ? 1 : close < loma[1] ? -1 : hilo

prevRef  = newDay ? open : close[1]
crossUp  = close > U1 and prevRef <= U1
crossDn  = close < D1 and prevRef >= D1

rawLong  = crossUp and close < U2 and (not useHiLo or hilo == 1) and (not oncePerDay or not tookL)
rawShort = crossDn and close > D2 and (not useHiLo or hilo == -1) and (not oncePerDay or not tookS)
longExit  = useHiLo and hilo == -1 and hilo[1] == 1
shortExit = useHiLo and hilo == 1 and hilo[1] == -1
if barstate.isconfirmed
    if rawLong
        tookL := true
    if rawShort
        tookS := true

longSLcalc  = slMode == "Base level" ? base : (base + U1) / 2
shortSLcalc = slMode == "Base level" ? base : (base + D1) / 2
longT1c  = U2
longT2c  = U3
longT3c  = U4
shortT1c = D2
shortT2c = D3
shortT3c = D4

// trail one Gann level behind price
dist       = (math.sqrt(close) - rt) / step
longTrail  = gLvl(rt, step, int(math.floor(dist)) - 1)
shortTrail = gLvl(rt, step, int(math.ceil(dist)) + 1)
usePeakTrail = false
peakTrailPct = 0.0

trendTxt    = hilo == 1 ? "Gann HiLo up ▲" : hilo == -1 ? "Gann HiLo down ▼" : "Neutral"
trendCol    = hilo == 1 ? cBull : hilo == -1 ? cBear : cMuted
strengthTxt = "Base " + fmt(base) + " · " + angle + " · buy > " + fmt(U1) + " · sell < " + fmt(D1)

showG = not newDay
plot(showG ? base : na, "Gann base", color=color.new(cGold, 0), style=plot.style_linebr, linewidth=2)
plot(showG ? U1 : na, "Buy above (U1)", color=color.new(cBull, 0), style=plot.style_linebr, linewidth=2)
plot(showG ? U2 : na, "U2", color=color.new(cBull, 40), style=plot.style_linebr)
plot(showG ? U3 : na, "U3", color=color.new(cBull, 55), style=plot.style_linebr)
plot(showG ? U4 : na, "U4", color=color.new(cBull, 70), style=plot.style_linebr)
plot(showG ? D1 : na, "Sell below (D1)", color=color.new(cBear, 0), style=plot.style_linebr, linewidth=2)
plot(showG ? D2 : na, "D2", color=color.new(cBear, 40), style=plot.style_linebr)
plot(showG ? D3 : na, "D3", color=color.new(cBear, 55), style=plot.style_linebr)
plot(showG ? D4 : na, "D4", color=color.new(cBear, 70), style=plot.style_linebr)
plot(useHiLo ? (hilo == 1 ? loma : hima) : na, "Gann HiLo", color=hilo == 1 ? color.new(cBull, 50) : color.new(cBear, 50), style=plot.style_circles, linewidth=1)

var label[] gl = array.new<label>()
if barstate.islast and showLevels
    while array.size(gl) > 0
        label.delete(array.pop(gl))
    array.push(gl, label.new(bar_index + 2, U1, "BUY > " + fmt(U1), style=label.style_label_left, color=color.new(cPanel, 10), textcolor=cBull, size=size.small))
    array.push(gl, label.new(bar_index + 2, U2, "U2 " + fmt(U2), style=label.style_label_left, color=color.new(cPanel, 10), textcolor=cBull, size=size.tiny))
    array.push(gl, label.new(bar_index + 2, U3, "U3 " + fmt(U3), style=label.style_label_left, color=color.new(cPanel, 10), textcolor=cBull, size=size.tiny))
    array.push(gl, label.new(bar_index + 2, base, "BASE " + fmt(base), style=label.style_label_left, color=color.new(cPanel, 10), textcolor=cGold, size=size.small))
    array.push(gl, label.new(bar_index + 2, D1, "SELL < " + fmt(D1), style=label.style_label_left, color=color.new(cPanel, 10), textcolor=cBear, size=size.small))
    array.push(gl, label.new(bar_index + 2, D2, "D2 " + fmt(D2), style=label.style_label_left, color=color.new(cPanel, 10), textcolor=cBear, size=size.tiny))
    array.push(gl, label.new(bar_index + 2, D3, "D3 " + fmt(D3), style=label.style_label_left, color=color.new(cPanel, 10), textcolor=cBear, size=size.tiny))

// ═════════════════ Trade engine — evaluated on candle close (non-repainting) ═════════════════
var int    pos      = 0
var float  entryPx  = na
var float  initSL   = na
var float  stopPx   = na
var float  tgt1     = na
var float  tgt2     = na
var float  tgt3     = na
var bool   hit1     = false
var bool   hit2     = false
var bool   hit3     = false
var int    entryBar = na
var float  peak     = na
var string lastRes  = "—"
var int    nTrades  = 0
var int    nWins    = 0
var float  sumR     = 0.0

bool   evEntryL = false
bool   evEntryS = false
bool   evT1     = false
bool   evT2     = false
bool   evT3     = false
bool   evBE     = false
bool   evExit   = false
int    exitSide = 0
string exitWhy  = ""
float  exitPx   = na
float  exitR    = na

exitL = longExit or rawShort
exitS = shortExit or rawLong

if barstate.isconfirmed
    // 1 ─ manage the open trade (stop is checked before targets: conservative)
    if pos != 0 and bar_index > entryBar
        if pos == 1
            peak := math.max(nz(peak, high), high)
            if low <= stopPx
                evExit := true
                exitPx := math.min(open, stopPx)
            else
                if not hit1 and high >= tgt1
                    hit1 := true
                    evT1 := true
                if not hit2 and high >= tgt2
                    hit2 := true
                    evT2 := true
                if not hit3 and high >= tgt3
                    hit3 := true
                    evT3 := true
                    if exitAtT3
                        evExit  := true
                        exitPx  := tgt3
                        exitWhy := "T3 BOOKED"
        else
            peak := math.min(nz(peak, low), low)
            if high >= stopPx
                evExit := true
                exitPx := math.max(open, stopPx)
            else
                if not hit1 and low <= tgt1
                    hit1 := true
                    evT1 := true
                if not hit2 and low <= tgt2
                    hit2 := true
                    evT2 := true
                if not hit3 and low <= tgt3
                    hit3 := true
                    evT3 := true
                    if exitAtT3
                        evExit  := true
                        exitPx  := tgt3
                        exitWhy := "T3 BOOKED"
        if not evExit and ((pos == 1 and exitL) or (pos == -1 and exitS))
            evExit  := true
            exitPx  := close
            exitWhy := "EXIT SIGNAL"
        if not evExit and sqOffNow
            evExit  := true
            exitPx  := close
            exitWhy := "EOD SQUARE-OFF"
        if evExit
            float riskU = math.abs(entryPx - initSL)
            exitR := riskU > 0 ? pos * (exitPx - entryPx) / riskU : 0.0
            if exitWhy == ""
                exitWhy := math.abs(exitPx - entryPx) <= syminfo.mintick ? "BREAKEVEN EXIT" : pos * (exitPx - entryPx) > 0 ? "TRAILING SL HIT" : "STOP LOSS HIT"
            nTrades  += 1
            nWins    += exitR > 0 ? 1 : 0
            sumR     += exitR
            lastRes  := exitWhy + "  " + (exitR >= 0 ? "+" : "") + str.tostring(exitR, "#.##") + "R"
            exitSide := pos
            pos      := 0
        else
            // 2 ─ ratchet the stop for the next candle (it only ever moves in your favour)
            bool  trailOn = trailStart == "Immediately" or (trailStart == "After T1" and hit1)
            float cand    = na
            if trailOn
                if usePeakTrail
                    cand := pos == 1 ? peak * (1 - peakTrailPct / 100) : peak * (1 + peakTrailPct / 100)
                else
                    cand := pos == 1 ? longTrail : shortTrail
            float newStop = stopPx
            if pos == 1
                if not na(cand) and cand < close
                    newStop := math.max(newStop, cand)
                if beAfterT1 and hit1
                    newStop := math.max(newStop, entryPx)
                if lockAfterT2 and hit2
                    newStop := math.max(newStop, tgt1)
                evBE := stopPx < entryPx and newStop >= entryPx
            else
                if not na(cand) and cand > close
                    newStop := math.min(newStop, cand)
                if beAfterT1 and hit1
                    newStop := math.min(newStop, entryPx)
                if lockAfterT2 and hit2
                    newStop := math.min(newStop, tgt1)
                evBE := stopPx > entryPx and newStop <= entryPx
            stopPx := newStop

    // 3 ─ new entries
    if pos == 0 and inSess and not sqOffNow and (not evExit or allowReverse)
        if rawLong and not na(longSLcalc) and longSLcalc < close and not na(longT1c)
            pos      := 1
            entryPx  := close
            initSL   := longSLcalc
            stopPx   := longSLcalc
            tgt1     := longT1c
            tgt2     := longT2c
            tgt3     := longT3c
            hit1     := false
            hit2     := false
            hit3     := false
            entryBar := bar_index
            peak     := close
            evEntryL := true
        else if rawShort and not na(shortSLcalc) and shortSLcalc > close and not na(shortT1c)
            pos      := -1
            entryPx  := close
            initSL   := shortSLcalc
            stopPx   := shortSLcalc
            tgt1     := shortT1c
            tgt2     := shortT2c
            tgt3     := shortT3c
            hit1     := false
            hit2     := false
            hit3     := false
            entryBar := bar_index
            peak     := close
            evEntryS := true

// ═════════════════ Chart levels ═════════════════
active = pos != 0 and showLevels
pE  = plot(active ? entryPx : na, "Entry", color=color.new(cMuted, 0), style=plot.style_linebr, linewidth=1)
pSL = plot(active ? stopPx : na, "Stop loss / trailing SL", color=cBear, style=plot.style_linebr, linewidth=2)
pT1 = plot(active ? tgt1 : na, "Target 1", color=color.new(cBull, hit1 ? 60 : 0), style=plot.style_linebr, linewidth=1)
plot(active ? tgt2 : na, "Target 2", color=color.new(cBull, hit2 ? 60 : 0), style=plot.style_linebr, linewidth=1)
plot(active ? tgt3 : na, "Target 3", color=color.new(cBull, hit3 ? 60 : 0), style=plot.style_linebr, linewidth=1)
fill(pE, pSL, color.new(cBear, 88), "Risk zone")
fill(pE, pT1, color.new(cBull, 90), "Reward zone")

instTxt(int side, float px) =>
    string t = ""
    if isOptMode
        float strike = math.round(px / strikeStep) * strikeStep
        t := "BUY " + syminfo.root + " " + str.tostring(strike, "#") + (side == 1 ? " CE" : " PE")
    else
        t := side == 1 ? "BUY " + syminfo.ticker : "SELL " + syminfo.ticker
    t

if showLabels
    if evEntryL
        label.new(bar_index, low, "BUY ▲\n" + fmt(entryPx) + "\nSL " + fmt(initSL), yloc=yloc.belowbar, style=label.style_label_up, color=cBull, textcolor=color.white, size=size.small)
    if evEntryS
        label.new(bar_index, high, "SELL ▼\n" + fmt(entryPx) + "\nSL " + fmt(initSL), yloc=yloc.abovebar, style=label.style_label_down, color=cBear, textcolor=color.white, size=size.small)
    if evT1
        label.new(bar_index, tgt1, "T1 ✓", style=label.style_label_left, color=color.new(cBull, 100), textcolor=cBull, size=size.tiny)
    if evT2
        label.new(bar_index, tgt2, "T2 ✓", style=label.style_label_left, color=color.new(cBull, 100), textcolor=cBull, size=size.tiny)
    if evT3
        label.new(bar_index, tgt3, "T3 ✓", style=label.style_label_left, color=color.new(cBull, 100), textcolor=cBull, size=size.tiny)
    if evBE
        label.new(bar_index, entryPx, "SL → cost", style=label.style_label_left, color=color.new(cGold, 100), textcolor=cGold, size=size.tiny)
    if evExit
        label.new(bar_index, exitPx, exitWhy + "\n" + (exitR >= 0 ? "+" : "") + str.tostring(exitR, "#.##") + "R", style=exitSide == 1 ? label.style_label_down : label.style_label_up, color=exitR >= 0 ? color.new(cBull, 30) : color.new(cBear, 30), textcolor=color.white, size=size.tiny)

// ═════════════════ Dashboard ═════════════════
dashPos = switch dashLoc
    "Top Right"    => position.top_right
    "Bottom Right" => position.bottom_right
    "Top Left"     => position.top_left
    => position.bottom_left
tSize = switch dashSizeIn
    "Tiny"   => size.tiny
    "Normal" => size.normal
    => size.small

var table dash = table.new(dashPos, 2, 17, bgcolor=cPanel, frame_color=cEdge, frame_width=1, border_color=color.new(cEdge, 40), border_width=1)

row(table t, int r, string k, string v, color vc, string tsz) =>
    table.cell(t, 0, r, k, text_color=cMuted, text_size=tsz, text_halign=text.align_left)
    table.cell(t, 1, r, v, text_color=vc, text_size=tsz, text_halign=text.align_right)

if showDash and barstate.islast
    bool  inTrade = pos != 0
    float riskPts = inTrade ? math.abs(entryPx - initSL) : na
    float unitR   = inTrade ? (isOptMode ? riskPts * optDelta : riskPts) : na
    int   lots    = inTrade and unitR > 0 ? int(math.floor(capital * riskPct / 100 / (unitR * lotSize))) : 0
    float liveR   = inTrade and riskPts > 0 ? pos * (close - entryPx) / riskPts : na
    color sideCol = pos == 1 ? cBull : pos == -1 ? cBear : cMuted
    string sigTxt = evEntryL ? "▲ BUY NOW" : evEntryS ? "▼ SELL NOW" : pos == 1 ? "LONG — holding" : pos == -1 ? "SHORT — holding" : "WAIT — no setup"
    string stTxt  = not inTrade ? "Flat" : (hit3 ? "T3 ✓  " : hit2 ? "T2 ✓  " : hit1 ? "T1 ✓  " : "Running  ") + (liveR >= 0 ? "+" : "") + str.tostring(liveR, "#.##") + "R"
    string winTxt = nTrades > 0 ? str.tostring(nTrades) + " trades · " + str.tostring(100.0 * nWins / nTrades, "#") + "% win · " + (sumR >= 0 ? "+" : "") + str.tostring(sumR, "#.#") + "R" : "No closed trades yet"

    table.cell(dash, 0, 0, "RAJAN Gann Sq9", text_color=cGold, text_size=tSize, text_halign=text.align_left)
    table.cell(dash, 1, 0, syminfo.ticker + " · " + timeframe.period, text_color=cMuted, text_size=tSize, text_halign=text.align_right)
    row(dash, 1,  "Signal",        sigTxt, sideCol, tSize)
    row(dash, 2,  "What to trade", inTrade ? instTxt(pos, entryPx) : "—", inTrade ? cText : cMuted, tSize)
    row(dash, 3,  "Entry",         inTrade ? fmt(entryPx) : "—", cText, tSize)
    row(dash, 4,  "Stop loss",     inTrade ? fmt(initSL) + "  (" + str.tostring(riskPts, "#.##") + " pts)" : "—", cBear, tSize)
    row(dash, 5,  "Trailing SL",   inTrade ? fmt(stopPx) + (stopPx != initSL ? "  ↑ moved" : "") : "—", cGold, tSize)
    row(dash, 6,  "Target 1",      inTrade ? fmt(tgt1) + (hit1 ? "  ✓" : "") : "—", cBull, tSize)
    row(dash, 7,  "Target 2",      inTrade ? fmt(tgt2) + (hit2 ? "  ✓" : "") : "—", cBull, tSize)
    row(dash, 8,  "Target 3",      inTrade ? fmt(tgt3) + (hit3 ? "  ✓" : "") : "—", cBull, tSize)
    row(dash, 9,  "Risk : reward", inTrade and riskPts > 0 ? "1 : " + str.tostring(math.abs(tgt3 - entryPx) / riskPts, "#.#") : "—", cText, tSize)
    row(dash, 10, "Option SL est.", inTrade and isOptMode ? "≈ " + str.tostring(riskPts * optDelta, "#.#") + " pts premium" : "—", cMuted, tSize)
    row(dash, 11, "Position size", inTrade ? (lots > 0 ? str.tostring(lots) + " lot(s) · risk ₹" + str.tostring(lots * unitR * lotSize, "#,###") : "0 — stop too wide for risk %") : "—", cText, tSize)
    row(dash, 12, "Status",        stTxt, sideCol, tSize)
    row(dash, 13, "Trend",         trendTxt, trendCol, tSize)
    row(dash, 14, "Strength",      strengthTxt, cText, tSize)
    row(dash, 15, "Last trade",    lastRes, cMuted, tSize)
    row(dash, 16, "On this chart", winTxt, cMuted, tSize)

// ═════════════════ Alerts ═════════════════
// Create ONE alert → Condition: this indicator → "Any alert() function call" to get every message below.
planTxt = " @ " + fmt(entryPx) + " | SL " + fmt(initSL) + " | T1 " + fmt(tgt1) + " | T2 " + fmt(tgt2) + " | T3 " + fmt(tgt3)
if evEntryL
    alert("RAJAN GANN ▲ BUY " + syminfo.ticker + planTxt + " | " + instTxt(1, entryPx), alert.freq_once_per_bar_close)
if evEntryS
    alert("RAJAN GANN ▼ SELL " + syminfo.ticker + planTxt + " | " + instTxt(-1, entryPx), alert.freq_once_per_bar_close)
if evT1
    alert("RAJAN GANN " + syminfo.ticker + " T1 hit " + fmt(tgt1) + (beAfterT1 ? " — move SL to cost " + fmt(entryPx) : ""), alert.freq_once_per_bar_close)
if evT2
    alert("RAJAN GANN " + syminfo.ticker + " T2 hit " + fmt(tgt2), alert.freq_once_per_bar_close)
if evT3
    alert("RAJAN GANN " + syminfo.ticker + " T3 hit " + fmt(tgt3), alert.freq_once_per_bar_close)
if evExit
    alert("RAJAN GANN " + syminfo.ticker + " EXIT — " + exitWhy + " @ " + fmt(exitPx) + " (" + str.tostring(exitR, "#.##") + "R)", alert.freq_once_per_bar_close)

