{
  "alias": [
    "rajanstocks.vercel.app",
    "algostocks.vercel.app"
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "static/**"
    }
  },
  "env": {
    "BHAV_CACHE_WRITE_DIR": "/tmp/bhav_cache"
  },
  "crons": [
    {
      "path": "/api/cron/morning-refresh",
      "schedule": "46 3 * * 1-5"
    },
    {
      "path": "/api/cron/morning-refresh",
      "schedule": "51 3 * * 1-5"
    },
    {
      "path": "/api/cron/weekly-cleanup",
      "schedule": "30 18 * * 6"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)docs' ':(exclude)qa' ':(exclude)tests' ':(exclude)*.md' ':(exclude)*_backtest.py' ':(exclude)strategy_audit.py' ':(exclude)run_backtest_ci.py' ':(exclude)accuracy_report.py'"
}